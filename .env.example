# Copia este archivo a .env y completa SOLO si vas a usar extracción en vivo.
# La demo funciona sin ninguna clave (modo simulado con extracciones en caché).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Opcional: clasificación con JEV (TypeSafe AI)
TYPESAFE_API_KEY=
# Blinka: solo claves de PRUEBA. Las claves blk_live_ se rechazan por diseño.
BLINKA_API_KEY=
